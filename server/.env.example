# Server
PORT=4000
JWT_SECRET=cambiame-en-produccion
CLIENT_ORIGIN=http://localhost:5173
# URL pública del server (sin barra final). Es la base del redirect_uri del
# login con Gitea; en producción suele coincidir con CLIENT_ORIGIN.
PUBLIC_URL=http://localhost:4000
# Cuentas de ejemplo (password compartida "demo") listadas en el login.
# Poner en false cuando el login con Gitea esté configurado.
AUTH_DEMO_MODE=true

# Base SQLite (dailies, calendario, identidades). Por defecto queda junto al
# server; en Docker el compose la apunta al volumen /data.
# DATABASE_PATH=

# Zona horaria del equipo. La rotación de facilitador y el número de daily se
# calculan con la fecha LOCAL: en un contenedor sin TZ (UTC), pasada cierta hora
# la app ya mostraría el facilitador de mañana.
TZ=Etc/UTC

# Roster del equipo: server/roster.json (gitignoreado; copiá
# roster.example.json y editalo) o la ruta que pongas acá.
# ROSTER_FILE=

# Fecha ancla de la rotación de facilitador; también marca dónde empieza una
# ronda. Cambiarla reacomoda toda la rotación: elegila una vez (p. ej. el día
# que el equipo empieza a usar la app) y no la toques.
DAILY_ROTATION_ANCHOR=2026-01-01

# Numeración correlativa de la daily. Si venían contando dailies por otro medio
# (chat, planilla), anclá el último valor conocido y la app sigue desde ahí.
# Es un dato de color: no alimenta ninguna métrica.
DAILY_NUMBER_ANCHOR_DATE=2026-01-01
DAILY_NUMBER_ANCHOR_VALUE=1

# Rondas completas del proceso anterior al ancla de rotación (una ronda = una
# pasada entera por el roster). Corre la numeración de ronda para que empalme
# con la que ya venían usando; 0 si arrancan de cero.
DAILY_ROUNDS_BEFORE_ANCHOR=0

# ---------------------------------------------------------------------------
# Gitea — poné GITEA_ENABLED=true + URL + token + repos para usar datos reales.
# Por defecto (false) la app corre con datos mock.
# El token puede venir del entorno del sistema (GITEA_TOKEN) sin escribirlo acá.
# ---------------------------------------------------------------------------
GITEA_ENABLED=false
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=

# Login real con Gitea (OAuth2). Registrá una app OAuth2 en Gitea
# (Configuración → Aplicaciones, o como admin) con redirect URI:
#   <PUBLIC_URL>/api/auth/gitea/callback
# y pegá acá el client id/secret. Solo entra quien está en el roster; el rol
# sale de roster.json. Independiente del token de métricas de arriba.
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=

# Repos a analizar (owner/repo separados por coma).
GITEA_REPOS=
# Alternativa: escanear todos los repos de estos orgs (ignora GITEA_REPOS).
# Ojo: con orgs grandes la sync tarda bastante más.
GITEA_ORGS=

# Ventana de análisis en meses (Gitea filtra por updated_at).
GITEA_WINDOW_MONTHS=6
# Requests en paralelo contra Gitea.
GITEA_CONCURRENCY=6
# Minutos que vive el snapshot en cache antes de re-sincronizar.
GITEA_CACHE_TTL_MINUTES=15
# Reviews por PR (1 request extra por PR). Necesario para reviews dados/recibidos.
GITEA_FETCH_REVIEWS=true
# Tamaño de PR en líneas (otro request por PR). Gitea 1.21 no devuelve
# additions/deletions en el listado ni en el detalle, sólo en /pulls/{n}/files.
GITEA_FETCH_SIZES=false
# Tope duro de PRs por sync.
GITEA_MAX_PRS=3000

# ---------------------------------------------------------------------------
# Jira Cloud — dejar vacío para stubbear la sincronización.
# JIRA_ENABLED habilita lecturas; JIRA_WRITE_ENABLED habilita comentarios
# reales (opt-in aparte, porque escribe en tickets del equipo).
# ---------------------------------------------------------------------------
JIRA_ENABLED=false
JIRA_WRITE_ENABLED=false
JIRA_BASE_URL=https://tuempresa.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Dominio para resolver identidades Gitea -> Jira (<giteaLogin>@dominio).
JIRA_EMAIL_DOMAIN=example.com
